# Backend Environment Variables
PROJECT_NAME="React n Data Marketplace"
API_V1_STR="/api/v1"
SECRET_KEY="dev-secret-key-change-in-production-please-make-it-long-and-secure"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database
# For docker/postgresql: postgresql://postgres:postgrespassword@localhost:5432/datamarketplace
# For local dev without docker: sqlite:///./sql_app.db
DATABASE_URL="sqlite:///./sql_app.db"

# Storage
STORAGE_PROVIDER="local" # local or minio
STORAGE_LOCAL_DIR="./storage"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_BUCKET="datamarketplace"
MINIO_SECURE=false

# Google Gemini AI Configuration
AI_PROVIDER="gemini" # gemini or mock
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Payment
PAYMENT_PROVIDER="mock"

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
